diff --git a/esp32/components/muse/dl-extra-req.yml b/esp32/components/muse/dl-extra-req.yml
new file mode 100644
index 0000000..14ef13f
--- /dev/null
+++ b/esp32/components/muse/dl-extra-req.yml
@@ -0,0 +1,8 @@
+# Extra esp-dl kernels the muse wake-word model needs but esp-sr's own
+# compile_req does not list: wn10_hiesp has 1x1 W8A16 convs WITHOUT bias
+# (packed key 0x0202 -> dl_tie728_w8a16_conv2d_11cn), which esp-sr's req
+# (bias variant only) strips. esp-dl unions reqs from all components.
+kernel_abi: 1
+ops: []
+kernels:
+  - dl_tie728_w8a16_conv2d_11cn
