diff --git a/esp32/tests/test_muse_brain_audio.py b/esp32/tests/test_muse_brain_audio.py
new file mode 100644
index 0000000..d99fbde
--- /dev/null
+++ b/esp32/tests/test_muse_brain_audio.py
@@ -0,0 +1,94 @@
+"""Validate bounded ADPCM WAV files with an independent decoder when available."""
+import io, math, os, shutil, shlex, struct, subprocess, tempfile, unittest, wave
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+MUSE=ROOT/'components/muse'
+
+class BrainAudio(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.tmp=tempfile.TemporaryDirectory();cls.addClassCleanup(cls.tmp.cleanup)
+        out=Path(cls.tmp.name)
+        driver=r'''
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "muse_brain_audio.h"
+int main(int argc,char **argv) {
+ assert(argc==2); size_t cap=strtoul(argv[1],NULL,10);
+ unsigned char *in=malloc(1000000),*guard=malloc(cap+64);
+ assert(in && guard); size_t len=fread(in,1,1000000,stdin);
+ memset(guard,0xa5,cap+64);
+ size_t n=muse_brain_wav_adpcm(guard+32,cap,in,len);
+ for(int i=0;i<32;i++) assert(guard[i]==0xa5 && guard[cap+32+i]==0xa5);
+ if(!n) for(size_t i=0;i<cap;i++) assert(guard[32+i]==0xa5);
+ assert(n<=cap); fwrite(guard+32,1,n,stdout); free(guard);free(in);
+}
+'''
+        (out/'driver.c').write_text(driver);cls.binary=out/'audio'
+        cmd=[*shlex.split(os.environ.get('CC','cc')),'-std=c11','-Wall','-Wextra','-Werror','-I',str(MUSE),str(out/'driver.c'),str(MUSE/'muse_brain_audio.c'),str(MUSE/'muse_adpcm.c'),'-o',str(cls.binary)]
+        r=subprocess.run(cmd,capture_output=True,text=True)
+        if r.returncode:raise AssertionError(r.stdout+r.stderr)
+        cls.ffmpeg=shutil.which('ffmpeg')
+        if cls.ffmpeg:
+            dec=subprocess.run([cls.ffmpeg,'-hide_banner','-decoders'],capture_output=True,text=True)
+            if 'adpcm_ima_wav' not in dec.stdout:cls.ffmpeg=None
+
+    @staticmethod
+    def pcm(samples,rate=16000,channels=1):
+        b=io.BytesIO()
+        with wave.open(b,'wb') as w:
+            w.setnchannels(channels);w.setsampwidth(2);w.setframerate(rate)
+            w.writeframes(struct.pack('<%dh'%len(samples),*samples))
+        return b.getvalue()
+
+    def encode(self,data,cap=400000):
+        r=subprocess.run([str(self.binary),str(cap)],input=data,capture_output=True)
+        self.assertEqual(r.returncode,0,r.stderr.decode(errors='replace'))
+        return r.stdout
+
+    def test_silence_blocks_have_standard_headers_and_exact_fact_length(self):
+        data=self.encode(self.pcm([0]*506))
+        self.assertEqual(len(data),60+512)
+        self.assertEqual(data[:4],b'RIFF');self.assertEqual(data[8:16],b'WAVEfmt ')
+        self.assertEqual(struct.unpack_from('<I',data,4)[0],len(data)-8)
+        self.assertEqual(struct.unpack_from('<HHIIHHHH',data,20),(17,1,16000,8110,256,4,2,505))
+        self.assertEqual(data[40:44],b'fact');self.assertEqual(struct.unpack_from('<I',data,48)[0],506)
+        self.assertEqual(data[52:56],b'data');self.assertEqual(struct.unpack_from('<I',data,56)[0],512)
+        self.assertEqual(data[60:],bytes(512))
+
+    def test_sample_counts_across_block_boundaries_and_capacity_guards(self):
+        for n in [1,2,504,505,506,1009,1010,1011,48000,320000]:
+            with self.subTest(samples=n):
+                data=self.encode(self.pcm([1234]*n));need=60+256*((n+504)//505)
+                self.assertEqual(len(data),need)
+                self.assertEqual(struct.unpack_from('<I',data,48)[0],n)
+                self.assertEqual(data[60:64],b'\xd2\x04\x00\x00')
+                self.assertEqual(self.encode(self.pcm([1234]*n),need-1),b'')
+                self.assertEqual(self.encode(self.pcm([1234]*n),need),data)
+
+    def test_wrong_pcm_formats_and_empty_or_truncated_input_are_rejected(self):
+        valid=self.pcm([10]*1000)
+        for bad in [b'',valid[:43],valid[:44],valid[:-1],self.pcm([10]*1000,8000),self.pcm([10]*1000,channels=2),b'NOPE'+valid[4:]]:
+            self.assertEqual(self.encode(bad),b'')
+        self.assertEqual(self.encode(valid,0),b'')
+        self.assertEqual(self.encode(valid,59),b'')
+
+    def test_streaming_pcm_headers_with_unknown_lengths_are_accepted(self):
+        raw=bytearray(self.pcm([0]*16000));raw[4:8]=raw[40:44]=b'\xff'*4
+        data=self.encode(raw)
+        self.assertEqual(struct.unpack_from('<I',data,48)[0],16000)
+        self.assertLess(len(data),len(raw)//3)
+
+    def test_ffmpeg_decodes_waveform_with_bounded_loss_and_tail_padding(self):
+        if not self.ffmpeg:self.skipTest('FFmpeg IMA ADPCM decoder unavailable')
+        samples=[int(10000*math.sin(2*math.pi*440*i/16000)) for i in range(16000)]
+        data=self.encode(self.pcm(samples));out=Path(self.tmp.name)
+        (out/'encoded.wav').write_bytes(data)
+        r=subprocess.run([self.ffmpeg,'-v','error','-i',str(out/'encoded.wav'),'-f','s16le','-acodec','pcm_s16le','-'],capture_output=True)
+        self.assertEqual(r.returncode,0,r.stderr.decode(errors='replace'))
+        decoded=struct.unpack('<%dh'%(len(r.stdout)//2),r.stdout)
+        self.assertGreaterEqual(len(decoded),len(samples));self.assertLess(len(decoded)-len(samples),505)
+        error=sum(abs(a-b) for a,b in zip(samples,decoded))/len(samples)
+        self.assertLess(error,500)
diff --git a/esp32/tests/test_muse_brain_http.py b/esp32/tests/test_muse_brain_http.py
new file mode 100644
index 0000000..9c659c3
--- /dev/null
+++ b/esp32/tests/test_muse_brain_http.py
@@ -0,0 +1,169 @@
+"""Exercise idle-close retries, ticket lifetime and origin changes with fake I/O."""
+import os, shlex, subprocess, tempfile, unittest
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+
+class BrainHTTP(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.tmp=tempfile.TemporaryDirectory(); cls.addClassCleanup(cls.tmp.cleanup)
+        out=Path(cls.tmp.name)
+        src=(ROOT/'components/muse/muse_chat_session.cpp').read_text()
+        origin=src[src.index('static bool same_https_origin('):src.index('static bool brain_share_speech(')]
+        transport=src[src.index('struct brain_transport_t {'):src.index('struct brain_stream_t {')]
+        post=src[src.index('static bool http_post('):src.index('static bool openai_perform(')]
+        code=r'''
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+#ifndef CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT
+#define CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT 1
+#endif
+#define CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS 1
+#define ESP_OK 0
+#define ESP_FAIL -1
+#define ESP_ERR_INVALID_STATE -2
+#define HTTP_METHOD_POST 1
+#define HTTP_METHOD_HEAD 2
+#define BRAIN_CA "brain root"
+#define TTS_CA "speech root"
+#define ESP_LOGE(tag, ...) ((void)std::printf(__VA_ARGS__))
+using esp_err_t=int;
+struct Raw { bool saved=false, offered=false; };
+using esp_transport_handle_t=Raw *;
+struct Client { Raw *raw; int status=200; void *tag=nullptr; };
+using esp_http_client_handle_t=Client *;
+struct esp_http_client_config_t {
+ const char *url=nullptr,*cert_pem=nullptr; int method=0,timeout_ms=0,buffer_size=0,buffer_size_tx=0;
+ int (*event_handler)(void *)=nullptr; void *user_data=nullptr;
+#if CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT
+ Raw *transport=nullptr;
+#endif
+ bool disable_auto_redirect=false;
+};
+static Client *s_openai_cli,*s_tts_cli;
+static char sink[1024];
+static char *s_http_sink=sink;
+static size_t s_http_sink_len;
+static unsigned s_tts_bytes_total;
+static bool s_tts_first;
+static size_t s_tts_skip;
+struct Stream { char reply[32]={}; size_t llen=0,plen=0; bool done=false; };
+static Stream *s_brain_stream;
+static int made,destroyed,closed,performed;
+struct Response { int err,status; bool body,ticket; };
+static std::vector<Response> responses;
+static size_t response_next;
+static bool latest_ticket;
+static int openai_http_event(void *) { return 0; }
+static const char *esp_err_to_name(int) { return "fake"; }
+Raw *esp_transport_ssl_init() { ++made; return new Raw; }
+void esp_transport_destroy(Raw *r) { ++destroyed; delete r; }
+void esp_transport_set_default_port(Raw *,int p) { assert(p==443); }
+void esp_transport_ssl_set_cert_data(Raw *,const char *,size_t) {}
+Client *esp_http_client_init(const esp_http_client_config_t *cfg) {
+ assert(cfg->disable_auto_redirect && cfg->method==HTTP_METHOD_POST);
+#if CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT
+ return new Client{cfg->transport};
+#else
+ return new Client{nullptr};
+#endif
+}
+void esp_http_client_cleanup(Client *c) { delete c; }
+void esp_http_client_set_url(Client *,const char *) {}
+void esp_http_client_set_method(Client *,int) {}
+void esp_http_client_set_user_data(Client *c,void *tag) { c->tag=tag; }
+void esp_http_client_set_header(Client *,const char *,const char *) {}
+void esp_http_client_set_post_field(Client *,const char *,size_t) {}
+int esp_http_client_close(Client *) { ++closed; return ESP_OK; }
+int esp_http_client_get_status_code(Client *c) { return c->status; }
+enum { ESP_TRANSPORT_SESSION_TICKET_SAVE,ESP_TRANSPORT_SESSION_TICKET_USE };
+int esp_transport_ssl_session_ticket_operation(Raw *r,int op) {
+ if(op==ESP_TRANSPORT_SESSION_TICKET_SAVE) { r->saved=latest_ticket; return ESP_OK; }
+ if(!r->saved) return ESP_ERR_INVALID_STATE; // Public API leaves an old offered pointer intact.
+ r->offered=true; return ESP_OK;
+}
+''' + origin + transport + r'''
+int esp_http_client_perform(Client *c) {
+ ++performed; assert(response_next<responses.size());
+ Response r=responses[response_next++]; c->status=r.status; latest_ticket=r.ticket;
+ if(r.body) {
+  http_save_ticket(c);
+  if(c->tag) s_tts_bytes_total+=100;
+  else if(s_brain_stream) std::strcpy(s_brain_stream->reply,"reply");
+  else { std::strcpy(s_http_sink,"heard"); s_http_sink_len=5; }
+ }
+ return r.err;
+}
+''' + post + r'''
+static bool request(const char *url="https://one.example/v1/stt",void *tag=nullptr) {
+ return http_post(&s_openai_cli,tag,url,"fake key","application/json","{}",2);
+}
+static void good(bool ticket=true) { responses.push_back({ESP_OK,200,true,ticket}); }
+int main(int argc,char **argv) {
+ assert(argc==2); std::string mode=argv[1];
+ if(mode=="warmup") {
+  responses.push_back({ESP_OK,405,false,true}); good();
+  assert(http_post(&s_openai_cli,nullptr,"https://one.example/v1/stt","fake key","application/json","",0,true));
+  assert(s_openai_cli && performed==1 && closed==0); assert(request());
+ } else if(mode=="idle-close") {
+  responses.push_back({ESP_OK,200,false,false}); good();
+  assert(request()); assert(performed==2 && closed==1);
+ } else if(mode=="http-error") {
+  responses.push_back({ESP_OK,401,false,false});
+  assert(!request()); assert(performed==1 && !s_openai_cli);
+ } else if(mode=="started-audio") {
+  responses.push_back({ESP_FAIL,200,true,true});
+  assert(!request("https://one.example/v1/tts",(void *)1)); assert(performed==1);
+ } else if(mode=="started-chat") {
+  Stream stream; s_brain_stream=&stream;
+  responses.push_back({ESP_FAIL,200,true,true});
+  assert(!request()); assert(performed==1 && !std::strcmp(stream.reply,"reply"));
+ } else if(mode=="origin") {
+  good(); good(); assert(request()); assert(request("https://two.example/v1/stt"));
+#if CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT
+  assert(made==2 && destroyed==1); assert(s_brain_transport.ticket_valid);
+#endif
+ } else if(mode=="missing-ticket") {
+  good(); good(false); good(); assert(request()); assert(request());
+#if CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT
+  assert(s_brain_transport.ticket_stale); assert(destroyed==0);
+#endif
+  assert(request());
+#if CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT
+  assert(destroyed==1 && made==2 && !s_brain_transport.ticket_stale);
+#endif
+ } else {
+  good(); good(); assert(request()); assert(request("https://one.example/v1/chat"));
+#if CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT
+  assert(made==1 && destroyed==0 && s_brain_transport.ticket_valid);
+#endif
+ }
