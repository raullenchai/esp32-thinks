+    if (!ssid[0] && DEV_WIFI_SSID[0]) {
+        muse_link_wifi_set(DEV_WIFI_SSID, DEV_WIFI_PASS);
+        muse_wifi_apply();
+        ESP_LOGI(TAG, "dev provision: wifi %s", DEV_WIFI_SSID);
+    }
+    if (muse_settings_hatch_token_len() == 0 && DEV_WIFI_SSID[0]) {
