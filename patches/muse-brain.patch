+void muse_voice_dump_tasks(void)
+{
+    /* No malloc here: in a wedged system the heap lock may be held by the
+     * very path we are autopsying, and the coroner must never block. */
+    static EXT_RAM_BSS_ATTR char s_buf[16 * 1024];
+    static EXT_RAM_BSS_ATTR TaskSnapshot_t s_snaps[40];
+    static volatile bool s_dumping;
+    if (s_dumping) {
+        return;
+    }
+    s_dumping = true;
+    size_t off = 0;
+    static const size_t cap = sizeof(s_buf);
+    vTaskSuspendAll();
+    UBaseType_t got = uxTaskGetSnapshotAll(s_snaps, sizeof(s_snaps) / sizeof(s_snaps[0]), NULL);
+    for (UBaseType_t i = 0; i < got && off < cap - 128; i++) {
+        XtExcFrame *xf = (XtExcFrame *) s_snaps[i].pxTopOfStack;
+        off += snprintf(s_buf + off, cap - off, "bt %s:", pcTaskGetName((TaskHandle_t)s_snaps[i].pxTCB));
+        if (!esp_stack_ptr_is_sane(xf->a1) || !esp_ptr_executable((void *)esp_cpu_process_stack_pc(xf->pc))) {
+            off += snprintf(s_buf + off, cap - off, " <invalid frame>\n");
+            continue;
+        }
+        esp_backtrace_frame_t frame = { .pc = xf->pc, .sp = xf->a1, .next_pc = xf->a0 };
+        for (int f = 0; f < 16 && off < cap - 16; f++) {
+            off += snprintf(s_buf + off, cap - off, " 0x%08lx", (unsigned long)esp_cpu_process_stack_pc(frame.pc));
+            if (!coroner_unwind(&frame)) {
+                break;
+            }
+        }
+        off += snprintf(s_buf + off, cap - off, "\n");
+    }
+    xTaskResumeAll();
+    ESP_LOGI(TAG, "coroner: walked %u tasks, int=%u min=%u", (unsigned)got,
+             (unsigned)xPortGetFreeHeapSize(), (unsigned)xPortGetMinimumEverFreeHeapSize());
+    char *base = s_buf;
+    for (char *p = base; p < base + off; p++) {
+        if (*p == '\n') {
+            *p = 0;
+            ESP_LOGI(TAG, "%s", base);
+            base = p + 1;
+        }
+    }
+    if (base < s_buf + off) {
+        ESP_LOGI(TAG, "%s", base);
+    }
+    s_dumping = false;
+}
+
+static void coroner_task(void *arg)
+{
+    uint32_t last = 0;
+    TickType_t moved = xTaskGetTickCount();
+    TickType_t dumped = moved;
+    TickType_t health = moved;
