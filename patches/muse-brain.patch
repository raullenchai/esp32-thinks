+/* ---- TTS: speaks gadget replies via OpenAI ---- */
+
+static void tts_data(const uint8_t *data, size_t len);
+
+static void decode(void);
+
+/* Chinese replies get their own TTS model when configured: chatterbox is the
+ * fastest but English-first, qwen3 handles Chinese properly. */
+static const char *tts_model_for(const char *text)
+{
+#ifdef TTS_MODEL_CJK
+    if (TTS_MODEL_CJK[0] && text) {
+        for (const unsigned char *p = (const unsigned char *)text; *p; p++) {
+            if (*p >= 0xE4 && *p <= 0xE9) {   /* CJK unified ideographs */
+                return TTS_MODEL_CJK;
+            }
+        }
+    }
+#endif
+    return TTS_MODEL;
+}
+
+/* Persistent HTTPS clients: STT + chat can share their client; streaming
+ * multi-sentence replies use a separate speech client. A completed short
+ * reply can reuse the chat socket for speech when origin and trust match. */
+static esp_http_client_handle_t s_openai_cli;
+static esp_http_client_handle_t s_tts_cli;
+
+/* A completed short chat reply can speak on the same authenticated socket.
+ * Match the full authority (including port); distinct providers keep separate
+ * clients and streaming multi-sentence replies keep their speech connection. */
+static bool same_https_origin(const char *a, const char *b)
+{
+    if (strncmp(a, "https://", 8) || strncmp(b, "https://", 8)) {
+        return false;
+    }
+    size_t alen = strcspn(a + 8, "/?#");
+    size_t blen = strcspn(b + 8, "/?#");
+    return alen && alen == blen && !strncmp(a + 8, b + 8, alen);
+}
+
+static bool brain_share_speech(void)
+{
+    return same_https_origin(BRAIN_CHAT_URL, TTS_URL) &&
+           !strcmp((const char *)BRAIN_CA, (const char *)TTS_CA);
+}
+/* Own the SSL transports so post-handshake TLS 1.3 tickets can be saved
+ * after reading headers. IDF's automatic save occurs before tickets arrive. */
+struct brain_transport_t {
+    esp_transport_handle_t handle;
+    char origin[256];
+    bool ticket_valid, ticket_stale;
+};
+static brain_transport_t s_brain_transport, s_speech_transport;
+
+static brain_transport_t &http_transport(esp_http_client_handle_t *cli)
+{
+    return cli == &s_openai_cli ? s_brain_transport : s_speech_transport;
+}
+
+static void http_discard(esp_http_client_handle_t *cli)
+{
+    if (*cli) {
+        esp_http_client_cleanup(*cli);
+        *cli = nullptr;
+    }
+    brain_transport_t &transport = http_transport(cli);
+    if (transport.handle) {
+        esp_transport_destroy(transport.handle);
+        transport.handle = nullptr;
+    }
+    transport.origin[0] = '\0';
+    transport.ticket_valid = transport.ticket_stale = false;
+}
+
+static void http_save_ticket(esp_http_client_handle_t client)
+{
+    brain_transport_t &transport = http_transport(
+        client == s_openai_cli ? &s_openai_cli : &s_tts_cli);
+#if CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS
+    if (transport.handle) {
+        esp_transport_ssl_session_ticket_operation(transport.handle, ESP_TRANSPORT_SESSION_TICKET_SAVE);
+        bool valid = esp_transport_ssl_session_ticket_operation(
+            transport.handle, ESP_TRANSPORT_SESSION_TICKET_USE) == ESP_OK;
+        /* SAVE may replace a previous ticket with NULL. The public USE
+         * API then leaves cfg.client_session unchanged; discard this
+         * transport before its next request so that pointer stays safe. */
+        transport.ticket_stale = !valid && (transport.ticket_valid || transport.ticket_stale);
+        transport.ticket_valid = valid;
+    }
+#endif
+}
+
+struct brain_stream_t {
+    char *reply;
+    size_t replysz;
+    char line[1536], pend[1024];
+    size_t llen, plen;
+    bool done, share_speech;
+};
+static brain_stream_t *s_brain_stream;
+static void brain_chat_data(const char *data, size_t len);
+
+static bool s_tts_overflow;   /* the MP3 buffer overflowed: speech was lost */
+static bool s_tts_first;      /* the next TTS response chunk is the first one */
+static size_t s_tts_skip;     /* ID3 tag bytes still to skip (the tag can span chunks) */
+
+static esp_err_t openai_http_event(esp_http_client_event_t *evt)
+{
+    if (evt->event_id == HTTP_EVENT_ON_CONNECTED && evt->client) {
+        /* Headers and the small chat/TTS body are separate writes. Let the
+         * body leave immediately rather than waiting for a delayed ACK. */
+        int fd = esp_http_client_get_socket(evt->client);
+        int on = 1;
+        if (fd >= 0) {
+            setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &on, sizeof(on));
+        }
+    }
+    if (evt->event_id == HTTP_EVENT_ON_HEADERS_COMPLETE && evt->client) {
+        http_save_ticket(evt->client);
+    }
+    if (evt->event_id == HTTP_EVENT_ON_DATA && evt->client &&
+        esp_http_client_get_status_code(evt->client) == 200) {
+        if (evt->client == s_openai_cli && s_brain_stream) {
+            brain_chat_data((const char *)evt->data, evt->data_len);
+            return ESP_OK;
+        }
+        if (evt->user_data) {
+            const uint8_t *d = (const uint8_t *)evt->data;
+            size_t len = evt->data_len;
+            if (s_tts_first) {
+                /* Responses 2+ join a stream that is already mid-decode: drop
+                 * their ID3 tag or minimp3 loses sync. */
+                s_tts_first = false;
+                if (len >= 10 && d[0] == 'I' && d[1] == 'D' && d[2] == '3') {
+                    size_t skip = 10 + (((size_t)(d[6] & 0x7f) << 21) | ((d[7] & 0x7f) << 14) |
+                                        ((d[8] & 0x7f) << 7) | (d[9] & 0x7f));
+                    if (skip >= len) {
+                        s_tts_skip = skip - (size_t)len;   /* tag continues in the next chunk */
+                        return ESP_OK;
+                    }
+                    d += skip;
+                    len -= skip;
+                }
+            } else if (s_tts_skip) {
+                if ((size_t)len <= s_tts_skip) {
+                    s_tts_skip -= (size_t)len;
+                    return ESP_OK;
+                }
+                d += s_tts_skip;
+                len -= s_tts_skip;
+                s_tts_skip = 0;
+            }
+            s_tts_bytes_total += len;
+            tts_data(d, len);
+            decode();   /* start speaking as soon as the first frames land */
+            return ESP_OK;
+        }
+        if (s_http_sink && s_http_sink_len < BRAIN_SINK_BYTES - 1) {
+            size_t room = BRAIN_SINK_BYTES - 1 - s_http_sink_len;
+            size_t n = evt->data_len < room ? evt->data_len : room;
+            memcpy(s_http_sink + s_http_sink_len, evt->data, n);
+            s_http_sink_len += n;
+        }
+    }
+    return ESP_OK;
+}
+
+/* POSTs on a kept-alive connection; a failed one is dropped and re-made next call. */
+static bool http_post(esp_http_client_handle_t *cli, void *tag, const char *url, const char *key,
+                      const char *content_type, const char *body, size_t len, bool warmup = false)
+{
+    brain_transport_t &transport = http_transport(cli);
+    size_t origin_len = strcspn(url + (strncmp(url, "https://", 8) ? 0 : 8), "/?#") + 8;
+    if (strncmp(url, "https://", 8) || origin_len >= sizeof(transport.origin)) {
+        ESP_LOGE(TAG, "brain: invalid HTTPS origin");
+        return false;
+    }
+    /* Session tickets belong to one origin. Independent STT/chat endpoints
+     * must never offer one provider another provider's ticket. */
+    if (*cli && (transport.ticket_stale || !same_https_origin(transport.origin, url))) {
+        http_discard(cli);
+    }
+    if (!*cli) {
+#if CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT
+        transport.handle = esp_transport_ssl_init();
+        if (!transport.handle) {
+            return false;
+        }
+#endif
+        memcpy(transport.origin, url, origin_len);
+        transport.origin[origin_len] = '\0';
+        const char *ca = (const char *)(tag ? TTS_CA : BRAIN_CA);
+#if CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT
+        esp_transport_set_default_port(transport.handle, 443);
+        esp_transport_ssl_set_cert_data(transport.handle, ca, strlen(ca));
+#endif
+        esp_http_client_config_t cfg = {};
+        cfg.url = url;
+        cfg.method = HTTP_METHOD_POST;
+        cfg.cert_pem = ca;
+        cfg.timeout_ms = 30000;
+        /* Exceed ALWAYSINTERNAL so HTTP buffers live in PSRAM, leaving
+         * internal memory for the audio drivers and Wi-Fi while WakeNet runs. */
+#if CONFIG_SPIRAM
+        int buffer_size = CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL >= 8192 ?
+                          CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL + 1 : 8192;
+        cfg.buffer_size = buffer_size;
+        cfg.buffer_size_tx = buffer_size;
+#endif
+        cfg.event_handler = openai_http_event;
+        cfg.user_data = tag;
+#if CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT
+        cfg.transport = transport.handle;
+#endif
+        cfg.disable_auto_redirect = true;
+        *cli = esp_http_client_init(&cfg);
+        if (!*cli) {
+            http_discard(cli);
+            ESP_LOGE(TAG, "openai: init failed");
+            return false;
+        }
+    }
+    s_http_sink_len = 0;
+    esp_http_client_set_url(*cli, url);
+    esp_http_client_set_method(*cli, warmup ? HTTP_METHOD_HEAD : HTTP_METHOD_POST);
+    esp_http_client_set_user_data(*cli, tag);
+    char auth[256];
+    snprintf(auth, sizeof(auth), "Bearer %s", key);
+    esp_http_client_set_header(*cli, "Authorization", auth);
+    esp_http_client_set_header(*cli, "Content-Type", content_type);
+    esp_http_client_set_post_field(*cli, body, len);
+    uint32_t audio_before = s_tts_bytes_total;
+    esp_err_t err = esp_http_client_perform(*cli);
+    int status = esp_http_client_get_status_code(*cli);
+    bool empty = tag ? s_tts_bytes_total == audio_before :
+                 (s_brain_stream ? !s_brain_stream->reply[0] : !s_http_sink_len);
+    if (!warmup && empty && (err != ESP_OK || status == 200)) {
+        /* A keep-alive FIN can surface as an empty 200. close() resets HTTP
+         * state while retaining this origin's ticket for the reconnect. */
+        if (transport.ticket_stale) {
+            /* Leave recovery to a fresh request if no usable ticket remains. */
+            http_discard(cli);
+            return false;
+        }
+        if (s_brain_stream && !tag) {
+            s_brain_stream->llen = s_brain_stream->plen = 0;
+            s_brain_stream->done = false;
+        }
+        if (tag) {
+            s_tts_first = true;
+            s_tts_skip = 0;
+        }
+        esp_http_client_close(*cli);
+        err = esp_http_client_perform(*cli);
+        status = esp_http_client_get_status_code(*cli);
+        empty = tag ? s_tts_bytes_total == audio_before :
+                (s_brain_stream ? !s_brain_stream->reply[0] : !s_http_sink_len);
+    }
+    bool ok = err == ESP_OK && (warmup || (status == 200 && !empty));
+    if (!ok) {
+        ESP_LOGE(TAG, "openai %s: err %s status %d sink %u", url, esp_err_to_name(err), status, (unsigned)s_http_sink_len);
+        http_discard(cli);
+    }
+    if (ok && s_http_sink) {
+        s_http_sink[s_http_sink_len] = '\0';
+    }
+    return ok;
+}
+
+static bool openai_perform(const char *url, const char *key, const char *content_type,
+                           const char *body, size_t len, int mode)
+{
+    s_tts_first = mode == 0;
+    s_tts_skip = 0;
+    return http_post(mode == 0 ? &s_tts_cli : &s_openai_cli, mode == 0 ? (void *)1 : nullptr,
+                     url, key, content_type, body, len);
+}
+
+/* A HEAD request prepares TCP/TLS without running transcription or chat.
+ * A 405 is fine: its complete HTTP response leaves a reusable connection.
+ * All calls run on muse_chat's task, so the clients have a single owner. */
+static void brain_http_warmup(void)
+{
+    const char *url = BRAIN_STT_URL[0] ? BRAIN_STT_URL : BRAIN_CHAT_URL "/chat/completions";
+    if (s_openai_cli && same_https_origin(s_brain_transport.origin, url)) {
+        return;
+    }
+    http_post(&s_openai_cli, nullptr, url, BRAIN_CHAT_KEY, "application/json", "", 0, true);
+}
+
+/* Streams one message MP3 from OpenAI into tts_data(); true on success. */
+static bool tts_fetch_openai(const char *text)
+{
+    static const char *URL = TTS_URL;
+    int64_t t0 = now_us();
+    s_tts_bytes_total = 0;
+
+    cJSON *root = cJSON_CreateObject();
+    if (!root) {
+        return false;
+    }
+    cJSON_AddStringToObject(root, "model", tts_model_for(text));
+    cJSON_AddStringToObject(root, "input", text);
+    if (TTS_VOICE[0]) {
+        cJSON_AddStringToObject(root, "voice", TTS_VOICE);
+    }
+    cJSON_AddStringToObject(root, "response_format", "mp3");
+    char *body = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (!body) {
+        return false;
+    }
+
+    s_tts_overflow = false;
+    bool ok = openai_perform(URL, TTS_API_KEY, "application/json", body, strlen(body), 0);
+    if (ok && s_tts_overflow) {
+        ok = false;   /* speech outran playback: captions are safer than broken audio */
+    }
+    free(body);
+    ESP_LOGI(TAG, "TTS %s: %u bytes in %lld ms", ok ? "ok" : "failed", s_tts_bytes_total, (now_us() - t0) / 1000);
+    return ok;
+}
+
+/* One sentence, spoken while the chat stream is still writing the next one.
+ * Appends to the turn's MP3 buffer without resetting it (sentences share it). */
+static bool tts_fetch_sentence(const char *text, size_t len,
+                               esp_http_client_handle_t *cli = &s_tts_cli)
+{
+    char say[1024];
+    size_t j = 0;
+    for (size_t i = 0; i < len && j + 2 < sizeof(say); i++) {
+        char c = text[i];
+        if (c == '*' || c == '#' || c == '`' || c == '_' || c == '\r') {
+            continue;
+        }
+        say[j++] = c;
+    }
+    say[j] = '\0';
+    bool blank = true;
+    for (size_t i = 0; i < j; i++) {
+        if (say[i] != ' ' && say[i] != '\n' && say[i] != '\r' && say[i] != '\t') {
+            blank = false;
+            break;
+        }
+    }
+    if (blank) {
+        return true;
+    }
+    cJSON *root = cJSON_CreateObject();
+    if (!root) {
+        return false;
+    }
+    cJSON_AddStringToObject(root, "model", tts_model_for(say));
+    cJSON_AddStringToObject(root, "input", say);
+    if (TTS_VOICE[0]) {
+        cJSON_AddStringToObject(root, "voice", TTS_VOICE);
+    }
+    cJSON_AddStringToObject(root, "response_format", "mp3");
+    char *body = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (!body) {
+        return false;
+    }
+    mark(M_TTS);
+    s_tts_first = true;
+    s_tts_skip = 0;
+    bool ok = http_post(cli, (void *)1, TTS_URL, TTS_API_KEY, "application/json", body, strlen(body));
+    if (*cli && cli == &s_openai_cli) {
+        esp_http_client_set_user_data(*cli, nullptr);
+    }
+    free(body);
+    return ok;
+}
