+
+#include "muse_io_watch.h"
+
+#include "esp_attr.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+
+typedef struct {
+    int64_t since_us;
+    bool pending;
+} io_watch_t;
+
+static io_watch_t s_watch[MUSE_IO_COUNT];
+static portMUX_TYPE s_lock = portMUX_INITIALIZER_UNLOCKED;
+
+void IRAM_ATTR muse_io_watch_begin(muse_io_t io)
+{
+    portENTER_CRITICAL_SAFE(&s_lock);
+    if (!s_watch[io].pending) {
+        s_watch[io].since_us = esp_timer_get_time();
+        s_watch[io].pending = true;
+    }
+    portEXIT_CRITICAL_SAFE(&s_lock);
+}
+
+void IRAM_ATTR muse_io_watch_end(muse_io_t io, bool success)
+{
+    portENTER_CRITICAL_SAFE(&s_lock);
+    if (success) {
+        s_watch[io].pending = false;
+    }
+    portEXIT_CRITICAL_SAFE(&s_lock);
+}
+
+uint32_t muse_io_watch_oldest(muse_io_t *io)
+{
+    int64_t age = 0;
+    portENTER_CRITICAL_SAFE(&s_lock);
+    int64_t now = esp_timer_get_time();
+    for (int i = 0; i < MUSE_IO_COUNT; i++) {
+        if (s_watch[i].pending && now - s_watch[i].since_us > age) {
+            age = now - s_watch[i].since_us;
+            *io = (muse_io_t)i;
+        }
+    }
+    portEXIT_CRITICAL_SAFE(&s_lock);
+    return age / 1000 > UINT32_MAX ? UINT32_MAX : (uint32_t)(age / 1000);
+}
+
+const char *muse_io_watch_name(muse_io_t io)
+{
+    static const char *names[] = { "I2S RX", "I2S TX", "audio power", "LCD flush", "LCD command" };
+    return io < MUSE_IO_COUNT ? names[io] : "none";
+}
