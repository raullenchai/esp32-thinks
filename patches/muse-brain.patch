+        if (beat != last) {
+            last = beat;
+            moved = now;
+            dumped = now;
+        }
+        /* A healthy device can sleep for a minute or wait longer for a cloud
+         * reply. Only outstanding peripheral work gets the short deadline. */
+        muse_io_t io = MUSE_IO_COUNT;
+        uint32_t io_ms = muse_io_watch_oldest(&io);
+        TickType_t stalled = now - moved;
+        if (io_ms >= 20000 || stalled >= pdMS_TO_TICKS(360000)) {
+            ESP_LOGE(TAG, "coroner: %s stalled %lu ms, voice idle %lu s — rebooting to recover",
+                     muse_io_watch_name(io), (unsigned long)io_ms,
+                     (unsigned long)(stalled / configTICK_RATE_HZ));
+            muse_voice_dump_tasks();
+            vTaskDelay(pdMS_TO_TICKS(3000));   /* let the zero-malloc dump drain */
+            esp_restart();
+        }
+        if (stalled >= pdMS_TO_TICKS(300000) && now - dumped >= pdMS_TO_TICKS(300000)) {
+            ESP_LOGE(TAG, "coroner: muse_voice stalled %lu s — all-task backtrace follows",
+                     (unsigned long)(stalled / configTICK_RATE_HZ));
+            muse_voice_dump_tasks();
+            dumped = now;   /* never reset the stall clock when dumping */
+        }
+        if (now - health >= pdMS_TO_TICKS(60000)) {
+            ESP_LOGI(TAG, "health: voice beat=%lu resting=%d io=%s age=%lu ms",
+                     (unsigned long)beat, (int)s_resting, muse_io_watch_name(io), (unsigned long)io_ms);
+            health = now;
+        }
+    }
+}
