+"""Exercise real peripheral deadline code with a deterministic host clock."""
+import os, shlex, subprocess, tempfile, unittest
+from pathlib import Path
+ROOT = Path(__file__).resolve().parents[1]
+
+class IoWatch(unittest.TestCase):
+    def test_pending_errors_recovery_sleep_and_independent_peripherals(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            out = Path(tmp)
+            (out / 'freertos').mkdir()
+            (out / 'esp_attr.h').write_text('#define IRAM_ATTR\n')
+            (out / 'esp_timer.h').write_text('#include <stdint.h>\nint64_t esp_timer_get_time(void);\n')
+            (out / 'freertos/FreeRTOS.h').write_text("""
+typedef int portMUX_TYPE;
+#define portMUX_INITIALIZER_UNLOCKED 0
+#define portENTER_CRITICAL_SAFE(p) ((void)(p))
+#define portEXIT_CRITICAL_SAFE(p) ((void)(p))
+""")
+            (out / 'driver.c').write_text(r"""
+#include <assert.h>
+#include <stdint.h>
+#include "muse_io_watch.h"
+static int64_t now;
+int64_t esp_timer_get_time(void) { return now; }
+static uint32_t age(muse_io_t want) {
+    muse_io_t actual = MUSE_IO_COUNT;
+    uint32_t ms = muse_io_watch_oldest(&actual);
+    assert(actual == want);
+    return ms;
+}
+int main(void) {
+    assert(age(MUSE_IO_COUNT) == 0);
+    /* A sleeping device with no I/O must never be considered wedged. */
+    now = 600000000;
+    assert(age(MUSE_IO_COUNT) == 0);
+    muse_io_watch_begin(MUSE_IO_RX);
+    now += 19999000;
+    assert(age(MUSE_IO_RX) == 19999);
+    now += 1000;
+    assert(age(MUSE_IO_RX) == 20000);
+    /* A returning driver error and further failed reads are still a stall. */
+    muse_io_watch_end(MUSE_IO_RX, false);
+    now += 1000000;
+    muse_io_watch_begin(MUSE_IO_RX);
+    assert(age(MUSE_IO_RX) == 21000);
+    muse_io_watch_end(MUSE_IO_RX, true);
+    assert(age(MUSE_IO_COUNT) == 0);
+    /* Healthy RX cannot mask an independent lost LCD completion. */
+    muse_io_watch_begin(MUSE_IO_LCD_FLUSH);
+    for (int i = 0; i < 1100; i++) {
+        muse_io_watch_begin(MUSE_IO_RX);
+        now += 20000;
+        muse_io_watch_end(MUSE_IO_RX, true);
+    }
+    assert(age(MUSE_IO_LCD_FLUSH) == 22000);
+    muse_io_watch_end(MUSE_IO_LCD_FLUSH, true);
+    assert(age(MUSE_IO_COUNT) == 0);
+    /* A stalled power transition must remain visible even when resting. */
+    muse_io_watch_begin(MUSE_IO_AUDIO_POWER);
+    now += 21000000;
+    assert(age(MUSE_IO_AUDIO_POWER) == 21000);
+    muse_io_watch_end(MUSE_IO_AUDIO_POWER, true);
+    /* 64-bit clock: no false reset around a 32-bit microsecond rollover. */
+    now = UINT32_MAX - 1000000LL;
+    muse_io_watch_begin(MUSE_IO_TX);
+    now += 23000000;
+    assert(age(MUSE_IO_TX) == 23000);
+    muse_io_watch_end(MUSE_IO_TX, true);
+    now += 360000000;
+    assert(age(MUSE_IO_COUNT) == 0);
+}
+""")
+            binary = out / 'watch'
+            cmd = [*shlex.split(os.environ.get('CC', 'cc')), '-std=c11', '-Wall', '-Wextra', '-Werror',
+                   '-I', str(out), '-I', str(ROOT / 'components/muse'), str(out / 'driver.c'),
