index 0000000..9b92d2b
--- /dev/null
+++ b/esp32/components/muse/muse_brain_audio.c
@@ -0,0 +1,60 @@
+/* Copyright (c) Meta Platforms, Inc. and affiliates.
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy at http://www.apache.org/licenses/LICENSE-2.0
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#include "muse_brain_audio.h"
+#include "muse_adpcm.h"
+#include <string.h>
+
+static uint16_t get16(const uint8_t *p) { return (uint16_t)(p[0] | (uint16_t)p[1] << 8); }
+static uint32_t get32(const uint8_t *p) { return get16(p) | (uint32_t)get16(p + 2) << 16; }
+static void put16(uint8_t *p, uint16_t v) { p[0] = v; p[1] = v >> 8; }
+static void put32(uint8_t *p, uint32_t v) { put16(p, v); put16(p + 2, v >> 16); }
+
+size_t muse_brain_wav_adpcm(uint8_t *out, size_t cap, const uint8_t *wav, size_t len)
+{
+    enum { PCM_HDR = 44, HDR = 60, BLOCK = 256, SAMPLES = 505, RATE = 16000 };
+    if (!out || !wav || cap < HDR || len <= PCM_HDR || (len - PCM_HDR) % 2 ||
+        memcmp(wav, "RIFF", 4) || memcmp(wav + 8, "WAVEfmt ", 8) ||
+        memcmp(wav + 36, "data", 4) || get32(wav + 16) != 16 ||
+        get16(wav + 20) != 1 || get16(wav + 22) != 1 ||
+        get32(wav + 24) != RATE || get16(wav + 32) != 2 || get16(wav + 34) != 16) {
+        return 0;
+    }
+    size_t n = (len - PCM_HDR) / 2;
+    size_t blocks = (n + SAMPLES - 1) / SAMPLES;
+    if (n > UINT32_MAX || blocks > (cap - HDR) / BLOCK || blocks > (UINT32_MAX - HDR) / BLOCK) {
+        return 0;
+    }
+    size_t bytes = blocks * BLOCK;
+    memset(out, 0, HDR);
+    memcpy(out, "RIFF", 4); put32(out + 4, HDR + bytes - 8);
+    memcpy(out + 8, "WAVEfmt ", 8); put32(out + 16, 20);
+    put16(out + 20, 0x11); put16(out + 22, 1);
+    put32(out + 24, RATE); put32(out + 28, RATE * BLOCK / SAMPLES);
+    put16(out + 32, BLOCK); put16(out + 34, 4);
+    put16(out + 36, 2); put16(out + 38, SAMPLES);
+    memcpy(out + 40, "fact", 4); put32(out + 44, 4); put32(out + 48, n);
+    memcpy(out + 52, "data", 4); put32(out + 56, bytes);
+    const uint8_t *pcm = wav + PCM_HDR;
+    muse_adpcm_t state = {0};
+    int16_t block[SAMPLES - 1];
+    for (size_t i = 0; i < blocks; i++) {
+        size_t at = i * SAMPLES;
+        uint8_t *p = out + HDR + i * BLOCK;
+        state.pred = (int16_t)get16(pcm + 2 * at);
+        put16(p, (uint16_t)state.pred); p[2] = state.index; p[3] = 0;
+        for (size_t j = 0; j < SAMPLES - 1; j++) {
+            size_t sample = at + 1 + j;
+            block[j] = (int16_t)get16(pcm + 2 * (sample < n ? sample : n - 1));
+        }
+        muse_adpcm_encode_block(&state, block, SAMPLES - 1, p + 4);
+    }
+    return HDR + bytes;
+}
