+/* Chat: appends the prompt to the rolling history, asks the model. */
+/* Makes room in the MP3 buffer for the next sentence. */
+static void brain_pump_audio(void)
+{
+    while (s_turn.mp3_len + 8192 > MP3_BUF) {
+        decode();
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+}
