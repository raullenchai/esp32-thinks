+/* TWDT only shows the CPU's *running* task; a blocked muse_voice needs its
+ * own stack walked. This low-prio coroner dumps every task's backtrace when
+ * the voice loop stops beating. */
+static bool coroner_unwind(esp_backtrace_frame_t *frame)   /* esp_backtrace_unwind_frame is not public */
+{
+    if (!esp_stack_ptr_is_sane(frame->sp)) {
+        return false;
+    }
+    void *base_save = (void *)frame->sp;   /* base save area: 4 words under SP */
+    frame->pc = frame->next_pc;
+    frame->next_pc = *((uint32_t *)(base_save - 16));
+    frame->sp = *((uint32_t *)(base_save - 12));
+    return esp_stack_ptr_is_sane(frame->sp) &&
+           esp_ptr_executable((void *)esp_cpu_process_stack_pc(frame->pc));
+}
