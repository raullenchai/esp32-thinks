+        memcpy(s_wake_buf + s_wake_fill, pcm, take * sizeof(int16_t));
+        s_wake_fill += take;
+        pcm += take;
+        frames -= take;
+        if (s_wake_fill < s_wake_need) {
+            return;
+        }
