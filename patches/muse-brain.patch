+/* Headless dev provisioning: a board flashed with DEV_WIFI_SSID writes its
+ * credentials and a placeholder token on boot, so the brain works without the
+ * BLE phone-setup flow. Empty DEV_WIFI_SSID disables it. */
+static void dev_provision_task(void *arg)
+{
+    vTaskDelay(pdMS_TO_TICKS(5000));
+    char ssid[MUSE_SSID_MAX + 1] = {0}, pass[MUSE_PASS_MAX + 1] = {0};
