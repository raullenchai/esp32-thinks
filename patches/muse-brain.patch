+/* Chat: appends the prompt to the rolling history, asks the model. */
+/* Makes room in the MP3 buffer for the next sentence. */
+static void drain_out(void);
+
+static void brain_pump_audio(void)
+{
+    while (s_turn.mp3_len + 8192 > MP3_BUF) {
+        if (s_turn.text) {
+            /* Typed turns have no playback drain of their own: without this a
+             * long reply fills s_out, decode() stalls and the pump spins. */
+            drain_out();
+        }
+        decode();
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+}
+
+/* Streams the reply: each finished sentence is spoken while the model is
+ * still writing the rest. Returns the full reply text. */
+static bool brain_chat_stream(const char *prompt, char *reply, size_t replysz)
+{
+    cJSON *body = cJSON_CreateObject();
+    if (!body) {
+        return false;
+    }
+    cJSON_AddStringToObject(body, "model", BRAIN_MODEL);
+    cJSON_AddBoolToObject(body, "stream", true);
+    cJSON *msgs = cJSON_CreateArray();
+    cJSON_AddItemToObject(body, "messages", msgs);
+    cJSON *m = cJSON_CreateObject();
+    cJSON_AddStringToObject(m, "role", "system");
+    cJSON_AddStringToObject(m, "content", BRAIN_SYSTEM);
+    cJSON_AddItemToArray(msgs, m);
+    for (int i = 0; i < s_brain_hist_n; i++) {
+        m = cJSON_CreateObject();
+        cJSON_AddStringToObject(m, "role", (i % 2) ? "assistant" : "user");
+        cJSON_AddStringToObject(m, "content", s_brain_hist + i * BRAIN_HIST_LEN);
+        cJSON_AddItemToArray(msgs, m);
+    }
+    m = cJSON_CreateObject();
+    cJSON_AddStringToObject(m, "role", "user");
+    cJSON_AddStringToObject(m, "content", prompt);
+    cJSON_AddItemToArray(msgs, m);
+#ifdef BRAIN_CHAT_EXTRA
+    if (BRAIN_CHAT_EXTRA[0]) {           /* provider quirks (e.g. no thinking) */
+        cJSON *extra = cJSON_Parse(BRAIN_CHAT_EXTRA);
+        if (extra) {
+            for (cJSON *c = extra->child; c; ) {
+                cJSON *next = c->next;
+                cJSON_AddItemToObject(body, c->string, cJSON_DetachItemViaPointer(extra, c));
+                c = next;
+            }
+            cJSON_Delete(extra);
+        }
+    }
+#endif
+    char *json = cJSON_PrintUnformatted(body);
+    cJSON_Delete(body);
+    if (!json) {
+        return false;
+    }
+
+    if (!s_openai_cli) {
+        esp_http_client_config_t cfg = {};
+        cfg.url = BRAIN_CHAT_URL;
+        cfg.method = HTTP_METHOD_POST;
+        cfg.cert_pem = (const char *)BRAIN_CA;
+        cfg.timeout_ms = 30000;
+        cfg.event_handler = openai_http_event;
+        cfg.user_data = nullptr;
+        s_openai_cli = esp_http_client_init(&cfg);
+        if (!s_openai_cli) {
+            cJSON_free(json);
+            return false;
+        }
+    }
+    s_tts_bytes_total = 0;
+    s_tts_overflow = false;
+    reply[0] = '\0';
+    bool ok = false;
+    size_t blen = strlen(json);
+    if (esp_http_client_set_url(s_openai_cli, BRAIN_CHAT_URL "/chat/completions") == ESP_OK &&
+        esp_http_client_set_method(s_openai_cli, HTTP_METHOD_POST) == ESP_OK) {
+        char auth[256];
+        snprintf(auth, sizeof(auth), "Bearer %s", BRAIN_CHAT_KEY);
+        esp_http_client_set_header(s_openai_cli, "Authorization", auth);
+        esp_http_client_set_header(s_openai_cli, "Content-Type", "application/json");
+        if (esp_http_client_open(s_openai_cli, blen) == ESP_OK &&
+            esp_http_client_write(s_openai_cli, json, blen) == (int)blen &&
+            esp_http_client_fetch_headers(s_openai_cli) >= 0 &&
+            esp_http_client_get_status_code(s_openai_cli) == 200) {
+            ok = true;
+            char chunk[1536], line[1536], pend[1024];
+            size_t llen = 0, plen = 0;
+            bool done = false;
+            for (;;) {
+                int n = esp_http_client_read(s_openai_cli, chunk, sizeof(chunk));
+                if (n <= 0) {
+                    ok = done || reply[0] != '\0';
+                    break;
+                }
+                for (int i = 0; i < n && !done; i++) {
+                    char c = chunk[i];
+                    if (c != '\n') {
+                        if (llen < sizeof(line) - 1) {
+                            line[llen++] = c;
+                        }
+                        continue;
+                    }
+                    line[llen] = '\0';
+                    llen = 0;
+                    if (strncmp(line, "data: ", 6)) {
+                        continue;
+                    }
+                    const char *s = line + 6;
+                    if (!strcmp(s, "[DONE]")) {
+                        done = true;
+                        break;
+                    }
+                    cJSON *e = cJSON_Parse(s);
+                    if (!e) {
+                        continue;
+                    }
+                    cJSON *ch = cJSON_GetArrayItem(cJSON_GetObjectItem(e, "choices"), 0);
+                    const char *delta = ch ? cJSON_GetStringValue(cJSON_GetObjectItem(cJSON_GetObjectItem(ch, "delta"), "content")) : nullptr;
+                    if (delta && delta[0]) {
+                        strlcat(reply, delta, replysz);
+                        const char *d = delta;
+                        size_t dl = strlen(d);
+                        while (dl > 0) {
+                            if (plen + dl >= sizeof(pend) - 1) {
+                                if (plen > 0) {   /* flush first so nothing is dropped */
+                                    brain_pump_audio();
+                                    tts_fetch_sentence(pend, plen);
+                                    plen = 0;
+                                    pend[0] = '\0';
+                                }
+                                if (dl >= sizeof(pend) - 1) {   /* cut the delta at a UTF-8 boundary */
+                                    size_t take = sizeof(pend) - 1;
+                                    while (take > 0 && (((const unsigned char *)d)[take] & 0xC0) == 0x80) {
+                                        take--;
+                                    }
+                                    memcpy(pend, d, take);
+                                    plen = take;
+                                    pend[plen] = '\0';
+                                    brain_pump_audio();
+                                    tts_fetch_sentence(pend, plen);
+                                    plen = 0;
+                                    pend[0] = '\0';
+                                    d += take;
+                                    dl -= take;
+                                    continue;
+                                }
+                            }
+                            memcpy(pend + plen, d, dl);
+                            plen += dl;
+                            pend[plen] = '\0';
+                            break;
+                        }
+                        bool brk = plen >= sizeof(pend) - 8;   /* never let it wrap */
+                        if (!brk && plen >= 2) {
+                            unsigned char last = (unsigned char)pend[plen - 1];
+                            brk = last == '.' || last == '!' || last == '?' || last == '\n';
+                            if (!brk && plen >= 3) {
+                                const unsigned char *t = (const unsigned char *)pend + plen - 3;
+                                brk = (t[0] == 0xE3 && t[1] == 0x80 && t[2] == 0x82) ||   /* 。 */
+                                      (t[0] == 0xEF && t[1] == 0xBC && t[2] == 0x81) ||   /* ！ */
+                                      (t[0] == 0xEF && t[1] == 0xBC && t[2] == 0x9F) ||   /* ？ */
+                                      (t[0] == 0xE2 && t[1] == 0x80 && t[2] == 0xA6);     /* … */
+                            }
+                        }
+                        if (brk && plen >= 1) {
+                            brain_pump_audio();
+                            tts_fetch_sentence(pend, plen);
+                            plen = 0;
+                            pend[0] = '\0';
+                        }
+                    }
+                    cJSON_Delete(e);
+                }
+                if (done) {
+                    break;
+                }
+            }
+            if (plen > 0) {
+                brain_pump_audio();
+                tts_fetch_sentence(pend, plen);
+            }
+        } else {
+            ESP_LOGE(TAG, "brain: stream open failed (status %d)", esp_http_client_get_status_code(s_openai_cli));
+        }
+        if (ok) {
+            /* drain the SSE tail so the socket is clean; esp_http_client_open()
+             * reuses a connected client (IDF: connect() skips when state >=
+             * CONNECTED), saving a TCP+TLS handshake every turn */
+            char junk[64];
+            while (esp_http_client_read(s_openai_cli, junk, sizeof(junk)) > 0) {}
+        }
+    }
+    cJSON_free(json);
+    if (!ok || s_turn.text) {
+        /* Typed turns give up the socket: the incremental API leaves the
+         * client mid-response, which a perform()-based caller (STT) would
+         * misread on its next use. */
+        esp_http_client_cleanup(s_openai_cli);
+        s_openai_cli = nullptr;
+    }
+    return ok;
+}
+
+static void brain_hist_add(const char *user, const char *assistant)
+{
+    if (!s_brain_hist) {
+        return;
+    }
+    if (s_brain_hist_n + 2 > BRAIN_HIST_MSGS) {
+        memmove(s_brain_hist, s_brain_hist + 2 * BRAIN_HIST_LEN, (s_brain_hist_n - 2) * BRAIN_HIST_LEN);
+        s_brain_hist_n -= 2;
+    }
+    strlcpy(s_brain_hist + s_brain_hist_n * BRAIN_HIST_LEN, user, BRAIN_HIST_LEN);
+    strlcpy(s_brain_hist + (s_brain_hist_n + 1) * BRAIN_HIST_LEN, assistant, BRAIN_HIST_LEN);
+    s_brain_hist_n += 2;
+}
+
+/* Injects the reply into the normal turn pipeline: captions, TTS, turn end.
+ * `console`: also emit the @chat frames a typed turn's client waits for, the
+ * "sent" ack first -- the client drops any frames that arrive before it. */
+static void brain_respond(const char *prompt, bool store, bool console)
+{
+    if (s_turn.nmsgs >= MAX_MSGS) {
+        turn_fail("TOO MANY MESSAGES");
+        return;
+    }
+    msg_t &m = s_turn.msgs[s_turn.nmsgs];
+    m = msg_t{};
+    strlcpy(m.id, "brain", sizeof(m.id));
+    /* Reserve the reply slot and TTS state up front, so the sentences that
+     * brain_chat_stream() feeds in start playing before the reply completes. */
+    s_turn.mp3_len = 0;
+    s_turn.mp3_ended = false;
+    s_turn.kbps = 0;
+    s_turn.down_rate = 0;
+    mp3dec_init(&s_turn.dec);
+    m.pcm_start = s_turn.pcm_out;
+    m.pcm_frames = 0;
+    m.tts = TTS_ACTIVE;
+    s_turn.tts_msg = s_turn.nmsgs;
+    s_turn.silent = false;
+    char reply[2048];
+    if (!brain_chat_stream(prompt, reply, sizeof(reply))) {
+        turn_fail("BRAIN UNREACHABLE");
+        return;
+    }
+    if (store) {
+        brain_hist_add(prompt, reply);
+    }
+    if (strlen(reply) >= TEXT_MAX) {
+        reply[TEXT_MAX - 1] = '\0';
+    }
+    append_text(m, reply);
+    m.done = true;
+    if (!s_turn.mp3_len) {
+        /* nothing was spoken: let start_tts() fetch the whole reply instead */
+        m.tts = TTS_QUEUED;
+        s_turn.tts_msg = -1;
+    } else {
+        s_turn.mp3_ended = true;   /* all sentences fetched: decode() drains, then finishes */
+        show_reply_start(m);
+    }
+    s_turn.nmsgs++;
+    if (console) {
+        s_brain_sent = true;
+        muse_hatch_console("sent", nullptr, "\"bytes\":%u", (unsigned)strlen(prompt));
+        muse_hatch_console("final", reply, "\"msg\":0");
+        muse_hatch_console("message_done", nullptr, "\"msg\":0,\"bytes\":%u", (unsigned)m.len);
+    }
+    ESP_LOGI(TAG, "brain reply: %u chars, %u audio bytes", (unsigned)m.len, (unsigned)s_turn.mp3_len);
+    s_turn.phase = P_WAIT_REPLY;
+}
+
+static void brain_voice_reply(void)
+{
+    char heard[1024];
+    if (!brain_stt(s_brain_note, s_brain_note_len, heard, sizeof(heard))) {
+        turn_fail("BRAIN STT FAILED");
+        return;
+    }
+    ESP_LOGI(TAG, "brain heard: %s", heard);
+    brain_respond(heard, true, false);
+}
+
+static void brain_text_turn(const char *text)
+{
+    s_turn.chat_posted = true;
+    s_turn.chat_us = s_turn.last_event_us = now_us();
+    brain_respond(text, true, s_turn.text);
+}
