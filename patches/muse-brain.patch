+
+    def test_coroner_fast_deadline_sleep_and_dump_do_not_delay_restart(self):
+        source = (ROOT / 'components/muse/muse_voice.c').read_text()
+        start = source.index('static void coroner_task(void *arg)')
+        coroner = source[start:source.index('\nstatic TaskHandle_t s_voice_task;', start)]
+        with tempfile.TemporaryDirectory() as tmp:
+            out = Path(tmp)
+            driver = r"""
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <setjmp.h>
+#include "muse_io_watch.h"
+typedef uint32_t TickType_t;
+#define pdMS_TO_TICKS(n) (n)
+#define configTICK_RATE_HZ 1000
+#define ESP_LOGE(...) ((void)0)
+#define ESP_LOGI(...) ((void)0)
+static uint32_t now, s_voice_beat, dumps, restarted;
+static bool s_resting;
+static int mode;
+static jmp_buf stop;
+static TickType_t xTaskGetTickCount(void) { return now; }
+static void vTaskDelay(uint32_t ms) {
+    now += ms;
+    /* 1: healthy voice while LCD is stuck. 2: normal minute-long sleep. */
+    if (mode == 1) s_voice_beat++;
+    if (mode == 2) s_voice_beat = now / 60000;
+    if (now > 700000) longjmp(stop, 1);
+}
+uint32_t muse_io_watch_oldest(muse_io_t *io) {
+    if (mode == 1) { *io = MUSE_IO_LCD_FLUSH; return now; }
+    return 0;
+}
+const char *muse_io_watch_name(muse_io_t io) { (void)io; return "test"; }
+static void muse_voice_dump_tasks(void) { dumps++; }
+static void esp_restart(void) { restarted = now; longjmp(stop, 1); }
+""" + coroner + r"""
+int main(int argc, char **argv) {
+    (void)argc; mode = atoi(argv[1]); s_resting = mode == 2;
+    if (!setjmp(stop)) coroner_task(NULL);
+    printf("%u %u\n", restarted, dumps);
+}
+"""
+            (out / 'driver.c').write_text(driver)
+            binary = out / 'coroner'
+            subprocess.run([*shlex.split(os.environ.get('CC', 'cc')), '-std=c11', '-Wall',
+                            '-Wno-unused-parameter', '-I', str(ROOT / 'components/muse'),
+                            str(out / 'driver.c'), '-o', str(binary)], check=True, capture_output=True)
+            def run(mode):
+                result = subprocess.run([str(binary), str(mode)], check=True, capture_output=True, text=True)
+                return tuple(map(int, result.stdout.split()))
+            restart, dumps = run(1)
+            self.assertGreaterEqual(restart, 23000)
+            self.assertLessEqual(restart, 24000)
+            self.assertEqual(dumps, 1)
+            self.assertEqual(run(2), (0, 0))
+            restart, dumps = run(0)
+            self.assertEqual(restart, 363000)
+            self.assertEqual(dumps, 2)
