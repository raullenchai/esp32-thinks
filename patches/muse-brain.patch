+/* ---- Brain: bring your own brain (any OpenAI-compatible endpoint) ---- */
+
+#define BRAIN_HIST_MSGS 8             /* user/assistant entries kept in RAM */
+#define BRAIN_HIST_LEN 512
+#define BRAIN_BOUNDARY "esp32thinks7d3a"
+
+/* Speech-to-text: multipart-uploads the staged WAV, returns the transcript. */
+/* Trim leading/trailing near-silence from a 16-bit mono WAV in place. The
+ * upload dominates the STT round trip and a PTT note is mostly air at the
+ * edges; keeping 200ms of padding preserves natural speech onsets. */
+static size_t wav_trim_silence(uint8_t *wav, size_t len)
+{
+    const size_t HDR = 44;
+    if (len <= HDR + 2 * 800) {   /* under ~50ms of audio */
+        return len;
+    }
+    int16_t *smp = (int16_t *)(wav + HDR);
+    size_t n = (len - HDR) / 2;
+    const int FLOOR_AMP = 80;   /* mic noise floor measured ~-55 dBFS */
+    const size_t PAD = 3200;    /* 200ms at 16 kHz */
+    size_t a = 0, b = n;
+    while (a < n && smp[a] < FLOOR_AMP && smp[a] > -FLOOR_AMP) {
+        a++;
+    }
+    while (b > a && smp[b - 1] < FLOOR_AMP && smp[b - 1] > -FLOOR_AMP) {
+        b--;
+    }
+    if (b <= a) {   /* all silence: keep the first 200ms so the server still answers */
+        a = 0;
+        b = n < 2 * PAD ? n : 2 * PAD;
+    } else {
+        a = a > PAD ? a - PAD : 0;
+        b = b + PAD < n ? b + PAD : n;
+    }
+    if (a == 0 && b == n) {
+        return len;
+    }
+    memmove(wav + HDR, wav + HDR + 2 * a, 2 * (b - a));
+    return HDR + 2 * (b - a);
+}
+
+static bool brain_stt(const uint8_t *wav, size_t len, char *out, size_t outlen)
+{
+    char head[640];
+    snprintf(head, sizeof(head),
+             "--" BRAIN_BOUNDARY "\r\n"
+             "Content-Disposition: form-data; name=\"model\"\r\n\r\n" BRAIN_STT_MODEL "\r\n"
+             "--" BRAIN_BOUNDARY "\r\n"
+             "Content-Disposition: form-data; name=\"language\"\r\n\r\n" BRAIN_STT_LANG "\r\n"
+             "--" BRAIN_BOUNDARY "\r\n"
+             "Content-Disposition: form-data; name=\"prompt\"\r\n\r\n" BRAIN_STT_PROMPT "\r\n"
+             "--" BRAIN_BOUNDARY "\r\n"
+             "Content-Disposition: form-data; name=\"file\"; filename=\"note.wav\"\r\n"
+             "Content-Type: audio/wav\r\n\r\n");
+    static const char tail[] = "\r\n--" BRAIN_BOUNDARY "--\r\n";
+    size_t hlen = strlen(head), tlen = strlen(tail);
+    len = wav_trim_silence((uint8_t *)wav, len);
+    memcpy(s_brain_post, head, hlen);
+    size_t audio_len = 0;
+#if defined(BRAIN_STT_WAV_ADPCM) && BRAIN_STT_WAV_ADPCM
+    /* The SDK's IMA encoder needs no new codec heap. WAV remains the API
+     * format, with about a quarter of the PCM upload bytes. Opt in only
+     * with a provider that has been verified to decode ADPCM WAV. */
+    audio_len = muse_brain_wav_adpcm(s_brain_post + hlen,
+                                   NOTE_MAX_BYTES + 1280 - hlen - tlen, wav, len);
+#endif
+    if (!audio_len) {
+        memcpy(s_brain_post + hlen, wav, len);
+        audio_len = len;
+    }
+    len = audio_len;
+    memcpy(s_brain_post + hlen + len, tail, tlen);
+    /* A reused keep-alive socket the server just closed yields a 0-byte 200;
+     * retry once right away instead of punting to the slow note path. */
+    bool got = false;
+    for (int attempt = 0; attempt < 2 && !got; attempt++) {
+        if (!openai_perform(BRAIN_STT_URL, BRAIN_CHAT_KEY, "multipart/form-data; boundary=" BRAIN_BOUNDARY,
+                        reinterpret_cast<const char *>(s_brain_post), hlen + len + tlen, 1)) {
+            ESP_LOGE(TAG, "STT http failed (attempt %d)", attempt);
+            continue;
+        }
+        ESP_LOGI(TAG, "STT resp %u bytes: %.200s", (unsigned)s_http_sink_len,
+                 s_http_sink ? (const char *)s_http_sink : "(null)");
+        got = s_http_sink_len > 0;
+    }
+    if (!got) {
+        return false;
+    }
+    cJSON *root = cJSON_Parse(s_http_sink);
+    if (!root) {
+        return false;
+    }
+    const char *text = cJSON_GetStringValue(cJSON_GetObjectItem(root, "text"));
+    bool ok = text && text[0];
+    if (ok) {
+        strlcpy(out, text, outlen);
+    }
+    cJSON_Delete(root);
+    return ok;
+}
+
+/* Chat: appends the prompt to the rolling history, asks the model. */
+/* Makes room in the MP3 buffer for the next sentence. */
+static void drain_out(void);
+
+static void brain_pump_audio(void)
+{
+    while (s_turn.mp3_len + 8192 > MP3_BUF) {
+        if (s_turn.text) {
+            /* Typed turns have no playback drain of their own: without this a
+             * long reply fills s_out, decode() stalls and the pump spins. */
+            drain_out();
+        }
+        decode();
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+}
+
+static void brain_chat_data(const char *data, size_t len)
+{
+    brain_stream_t &ctx = *s_brain_stream;
+    char *reply = ctx.reply;
+    size_t replysz = ctx.replysz;
+    auto &line = ctx.line;
+    auto &pend = ctx.pend;
+    size_t &llen = ctx.llen, &plen = ctx.plen;
+    bool &done = ctx.done;
+    bool &share_speech = ctx.share_speech;
+    for (size_t i = 0; i < len && !done; i++) {
+        char c = data[i];
+        if (c != '\n') {
+            if (llen < sizeof(line) - 1) {
+                line[llen++] = c;
+            }
+            continue;
+        }
+        line[llen] = '\0';
+        llen = 0;
+        if (strncmp(line, "data: ", 6)) {
+            continue;
+        }
+        const char *s = line + 6;
+        if (!strcmp(s, "[DONE]")) {
+            done = true;
+            break;
+        }
+        cJSON *e = cJSON_Parse(s);
+        if (!e) {
+            continue;
+        }
+        cJSON *ch = cJSON_GetArrayItem(cJSON_GetObjectItem(e, "choices"), 0);
+        const char *delta = ch ? cJSON_GetStringValue(cJSON_GetObjectItem(cJSON_GetObjectItem(ch, "delta"), "content")) : nullptr;
+        if (delta && delta[0]) {
+            strlcat(reply, delta, replysz);
+            const char *d = delta;
+            size_t dl = strlen(d);
+            while (dl > 0) {
+                if (plen + dl >= sizeof(pend) - 1) {
+                    if (plen > 0) {   /* flush first so nothing is dropped */
+                        brain_pump_audio();
+                        tts_fetch_sentence(pend, plen);
+                        plen = 0;
+                        pend[0] = '\0';
+                    }
+                    if (dl >= sizeof(pend) - 1) {   /* cut the delta at a UTF-8 boundary */
+                        size_t take = sizeof(pend) - 1;
+                        while (take > 0 && (((const unsigned char *)d)[take] & 0xC0) == 0x80) {
+                            take--;
+                        }
+                        memcpy(pend, d, take);
+                        plen = take;
+                        pend[plen] = '\0';
+                        brain_pump_audio();
+                        tts_fetch_sentence(pend, plen);
+                        plen = 0;
+                        pend[0] = '\0';
+                        d += take;
+                        dl -= take;
+                        continue;
+                    }
+                }
+                memcpy(pend + plen, d, dl);
+                plen += dl;
+                pend[plen] = '\0';
+                break;
+            }
+            /* Replies up to 128 UTF-8 bytes are a short burst, even when
+             * the model adds a greeting or a second tiny sentence. */
+            if (share_speech && plen >= 128) {
+                share_speech = false;
+            }
+            bool brk = plen >= sizeof(pend) - 8;   /* never let it wrap */
+            if (!brk && plen >= 2) {
+                unsigned char last = (unsigned char)pend[plen - 1];
+                brk = last == '.' || last == '!' || last == '?' || last == '\n';
+                if (!brk && plen >= 3) {
+                    const unsigned char *t = (const unsigned char *)pend + plen - 3;
+                    brk = (t[0] == 0xE3 && t[1] == 0x80 && t[2] == 0x82) ||   /* 。 */
+                          (t[0] == 0xEF && t[1] == 0xBC && t[2] == 0x81) ||   /* ！ */
+                          (t[0] == 0xEF && t[1] == 0xBC && t[2] == 0x9F) ||   /* ？ */
+                          (t[0] == 0xE2 && t[1] == 0x80 && t[2] == 0xA6);     /* … */
+                }
+            }
+            if (brk && plen >= 1) {
+                if (!share_speech) {
+                    brain_pump_audio();
+                    tts_fetch_sentence(pend, plen);
+                    plen = 0;
+                    pend[0] = '\0';
+                    share_speech = false;
+                }
+            }
+        }
+        cJSON_Delete(e);
+    }
+}
+
+/* Streams the reply: each finished sentence is spoken while the model is
+ * still writing the rest. Returns the full reply text. */
+static bool brain_chat_stream(const char *prompt, char *reply, size_t replysz)
+{
+    cJSON *body = cJSON_CreateObject();
+    if (!body) {
+        return false;
+    }
+    cJSON_AddStringToObject(body, "model", BRAIN_MODEL);
+    cJSON_AddBoolToObject(body, "stream", true);
+    cJSON *msgs = cJSON_CreateArray();
+    cJSON_AddItemToObject(body, "messages", msgs);
+    cJSON *m = cJSON_CreateObject();
+    cJSON_AddStringToObject(m, "role", "system");
+    cJSON_AddStringToObject(m, "content", BRAIN_SYSTEM);
+    cJSON_AddItemToArray(msgs, m);
+    for (int i = 0; i < s_brain_hist_n; i++) {
+        m = cJSON_CreateObject();
+        cJSON_AddStringToObject(m, "role", (i % 2) ? "assistant" : "user");
+        cJSON_AddStringToObject(m, "content", s_brain_hist + i * BRAIN_HIST_LEN);
+        cJSON_AddItemToArray(msgs, m);
+    }
+    m = cJSON_CreateObject();
+    cJSON_AddStringToObject(m, "role", "user");
+    cJSON_AddStringToObject(m, "content", prompt);
+    cJSON_AddItemToArray(msgs, m);
+#ifdef BRAIN_CHAT_EXTRA
+    if (BRAIN_CHAT_EXTRA[0]) {           /* provider quirks (e.g. no thinking) */
+        cJSON *extra = cJSON_Parse(BRAIN_CHAT_EXTRA);
+        if (extra) {
+            for (cJSON *c = extra->child; c; ) {
+                cJSON *next = c->next;
+                cJSON_AddItemToObject(body, c->string, cJSON_DetachItemViaPointer(extra, c));
+                c = next;
+            }
+            cJSON_Delete(extra);
+        }
+    }
+#endif
+    char *json = cJSON_PrintUnformatted(body);
+    cJSON_Delete(body);
+    if (!json) {
+        return false;
+    }
+
+    s_tts_bytes_total = 0;
+    s_tts_overflow = false;
+    reply[0] = '\0';
+    brain_stream_t ctx = {};
+    ctx.reply = reply;
+    ctx.replysz = replysz;
+    ctx.share_speech = brain_share_speech();
+    s_brain_stream = &ctx;
+    /* perform() returns the HTTP client to CONNECTED after consuming the
+     * body. The manual open/read API starts a new connection on every call. */
+    bool ok = http_post(&s_openai_cli, nullptr, BRAIN_CHAT_URL "/chat/completions",
+                        BRAIN_CHAT_KEY, "application/json", json, strlen(json));
+    s_brain_stream = nullptr;
+    cJSON_free(json);
+    ok = ok && reply[0];
+    if (ok && ctx.plen > 0) {
+        brain_pump_audio();
+        bool reusable = ctx.share_speech && s_openai_cli &&
+                        esp_http_client_is_complete_data_received(s_openai_cli);
+        ok = tts_fetch_sentence(ctx.pend, ctx.plen,
+                                reusable ? &s_openai_cli : &s_tts_cli);
+    }
+    return ok;
+}
+
+static void brain_hist_add(const char *user, const char *assistant)
+{
+    if (!s_brain_hist) {
+        return;
+    }
+    if (s_brain_hist_n + 2 > BRAIN_HIST_MSGS) {
+        memmove(s_brain_hist, s_brain_hist + 2 * BRAIN_HIST_LEN, (s_brain_hist_n - 2) * BRAIN_HIST_LEN);
+        s_brain_hist_n -= 2;
+    }
+    strlcpy(s_brain_hist + s_brain_hist_n * BRAIN_HIST_LEN, user, BRAIN_HIST_LEN);
+    strlcpy(s_brain_hist + (s_brain_hist_n + 1) * BRAIN_HIST_LEN, assistant, BRAIN_HIST_LEN);
+    s_brain_hist_n += 2;
+}
+
+/* Injects the reply into the normal turn pipeline: captions, TTS, turn end.
+ * `console`: also emit the @chat frames a typed turn's client waits for, the
+ * "sent" ack first -- the client drops any frames that arrive before it. */
+static void brain_respond(const char *prompt, bool store, bool console)
+{
+    if (s_turn.nmsgs >= MAX_MSGS) {
+        turn_fail("TOO MANY MESSAGES");
+        return;
+    }
+    msg_t &m = s_turn.msgs[s_turn.nmsgs];
+    m = msg_t{};
+    strlcpy(m.id, "brain", sizeof(m.id));
+    /* Reserve the reply slot and TTS state up front, so the sentences that
+     * brain_chat_stream() feeds in start playing before the reply completes. */
+    s_turn.mp3_len = 0;
+    s_turn.mp3_ended = false;
+    s_turn.kbps = 0;
+    s_turn.down_rate = 0;
+    mp3dec_init(&s_turn.dec);
+    m.pcm_start = s_turn.pcm_out;
+    m.pcm_frames = 0;
+    m.tts = TTS_ACTIVE;
+    s_turn.tts_msg = s_turn.nmsgs;
+    s_turn.silent = false;
+    char reply[2048];
+    if (!brain_chat_stream(prompt, reply, sizeof(reply))) {
+        turn_fail("BRAIN UNREACHABLE");
+        return;
+    }
+    if (store) {
+        brain_hist_add(prompt, reply);
+    }
+    if (strlen(reply) >= TEXT_MAX) {
+        reply[TEXT_MAX - 1] = '\0';
+    }
+    append_text(m, reply);
+    m.done = true;
+    if (!s_turn.mp3_len) {
+        /* nothing was spoken: let start_tts() fetch the whole reply instead */
+        m.tts = TTS_QUEUED;
+        s_turn.tts_msg = -1;
+    } else {
+        s_turn.mp3_ended = true;   /* all sentences fetched: decode() drains, then finishes */
+        show_reply_start(m);
+    }
+    s_turn.nmsgs++;
+    if (console) {
+        s_brain_sent = true;
+        muse_hatch_console("sent", nullptr, "\"bytes\":%u", (unsigned)strlen(prompt));
+        muse_hatch_console("final", reply, "\"msg\":0");
+        muse_hatch_console("message_done", nullptr, "\"msg\":0,\"bytes\":%u", (unsigned)m.len);
+    }
+    ESP_LOGI(TAG, "brain reply: %u chars, %u audio bytes", (unsigned)m.len, (unsigned)s_turn.mp3_len);
+    s_turn.phase = P_WAIT_REPLY;
+}
+
+static void brain_voice_reply(void)
+{
+    char heard[1024];
+    if (!brain_stt(s_brain_note, s_brain_note_len, heard, sizeof(heard))) {
+        turn_fail("BRAIN STT FAILED");
+        return;
+    }
+    ESP_LOGI(TAG, "brain heard: %s", heard);
+    brain_respond(heard, true, false);
+}
+
+static void brain_text_turn(const char *text)
+{
+    s_turn.chat_posted = true;
+    s_turn.chat_us = s_turn.last_event_us = now_us();
+    brain_respond(text, true, s_turn.text);
+}
