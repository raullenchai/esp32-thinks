+/* ---- TTS: speaks gadget replies via OpenAI ---- */
+
+static void tts_data(const uint8_t *data, size_t len);
+
+static void decode(void);
+
+/* Chinese replies get their own TTS model when configured: chatterbox is the
+ * fastest but English-first, qwen3 handles Chinese properly. */
+static const char *tts_model_for(const char *text)
+{
+#ifdef TTS_MODEL_CJK
+    if (TTS_MODEL_CJK[0] && text) {
+        for (const unsigned char *p = (const unsigned char *)text; *p; p++) {
+            if (*p >= 0xE4 && *p <= 0xE9) {   /* CJK unified ideographs */
+                return TTS_MODEL_CJK;
+            }
+        }
+    }
+#endif
+    return TTS_MODEL;
+}
+
+/* Two persistent TLS sessions: one for STT + chat, one for TTS -- a voice
+ * turn speaks sentences while the chat stream is still open, so they cannot
+ * share a connection. A fresh TCP+TLS handshake costs ~1 s here. */
+static esp_http_client_handle_t s_openai_cli;
+static esp_http_client_handle_t s_tts_cli;
+static bool s_tts_overflow;   /* the MP3 buffer overflowed: speech was lost */
+static bool s_tts_first;      /* the next TTS response chunk is the first one */
+static size_t s_tts_skip;     /* ID3 tag bytes still to skip (the tag can span chunks) */
+
+static esp_err_t openai_http_event(esp_http_client_event_t *evt)
+{
+    if (evt->event_id == HTTP_EVENT_ON_DATA && evt->client &&
+        esp_http_client_get_status_code(evt->client) == 200) {
+        if (evt->user_data) {
+            const uint8_t *d = (const uint8_t *)evt->data;
+            size_t len = evt->data_len;
+            if (s_tts_first) {
+                /* Responses 2+ join a stream that is already mid-decode: drop
+                 * their ID3 tag or minimp3 loses sync. */
+                s_tts_first = false;
+                if (len >= 10 && d[0] == 'I' && d[1] == 'D' && d[2] == '3') {
+                    size_t skip = 10 + (((size_t)(d[6] & 0x7f) << 21) | ((d[7] & 0x7f) << 14) |
+                                        ((d[8] & 0x7f) << 7) | (d[9] & 0x7f));
+                    if (skip >= len) {
+                        s_tts_skip = skip - (size_t)len;   /* tag continues in the next chunk */
+                        return ESP_OK;
+                    }
+                    d += skip;
+                    len -= skip;
+                }
+            } else if (s_tts_skip) {
+                if ((size_t)len <= s_tts_skip) {
+                    s_tts_skip -= (size_t)len;
+                    return ESP_OK;
+                }
+                d += s_tts_skip;
+                len -= s_tts_skip;
+                s_tts_skip = 0;
+            }
+            s_tts_bytes_total += len;
+            tts_data(d, len);
+            decode();   /* start speaking as soon as the first frames land */
+            return ESP_OK;
+        }
+        if (s_http_sink && s_http_sink_len < BRAIN_SINK_BYTES - 1) {
+            size_t room = BRAIN_SINK_BYTES - 1 - s_http_sink_len;
+            size_t n = evt->data_len < room ? evt->data_len : room;
+            memcpy(s_http_sink + s_http_sink_len, evt->data, n);
+            s_http_sink_len += n;
+        }
+    }
+    return ESP_OK;
+}
+
+/* POSTs on a kept-alive connection; a failed one is dropped and re-made next call. */
+static bool http_post(esp_http_client_handle_t *cli, void *tag, const char *url, const char *key,
+                      const char *content_type, const char *body, size_t len)
+{
+    if (!*cli) {
+        esp_http_client_config_t cfg = {};
+        cfg.url = url;
+        cfg.method = HTTP_METHOD_POST;
+        cfg.cert_pem = (const char *)(tag ? TTS_CA : BRAIN_CA);
+        cfg.timeout_ms = 30000;
+        cfg.event_handler = openai_http_event;
+        cfg.user_data = tag;
+        *cli = esp_http_client_init(&cfg);
+        if (!*cli) {
+            ESP_LOGE(TAG, "openai: init failed");
+            return false;
+        }
+    }
+    s_http_sink_len = 0;
+    esp_http_client_set_url(*cli, url);
+    char auth[256];
+    snprintf(auth, sizeof(auth), "Bearer %s", key);
+    esp_http_client_set_header(*cli, "Authorization", auth);
+    esp_http_client_set_header(*cli, "Content-Type", content_type);
+    esp_http_client_set_post_field(*cli, body, len);
+    esp_err_t err = esp_http_client_perform(*cli);
+    int status = esp_http_client_get_status_code(*cli);
+    bool ok = err == ESP_OK && status == 200;
+    if (!ok) {
+        ESP_LOGE(TAG, "openai %s: err %s status %d sink %u", url, esp_err_to_name(err), status, (unsigned)s_http_sink_len);
+        esp_http_client_cleanup(*cli);
+        *cli = nullptr;
+    }
+    if (ok && s_http_sink) {
+        s_http_sink[s_http_sink_len] = '\0';
+    }
+    return ok;
+}
+
+static bool openai_perform(const char *url, const char *key, const char *content_type,
+                           const char *body, size_t len, int mode)
+{
+    s_tts_first = mode == 0;
+    s_tts_skip = 0;
+    return http_post(mode == 0 ? &s_tts_cli : &s_openai_cli, mode == 0 ? (void *)1 : nullptr,
+                     url, key, content_type, body, len);
+}
+
+/* Streams one message MP3 from OpenAI into tts_data(); true on success. */
+static bool tts_fetch_openai(const char *text)
+{
+    static const char *URL = TTS_URL;
+    int64_t t0 = now_us();
+    s_tts_bytes_total = 0;
+
+    cJSON *root = cJSON_CreateObject();
+    if (!root) {
+        return false;
+    }
+    cJSON_AddStringToObject(root, "model", tts_model_for(text));
+    cJSON_AddStringToObject(root, "input", text);
+    if (TTS_VOICE[0]) {
+        cJSON_AddStringToObject(root, "voice", TTS_VOICE);
+    }
+    cJSON_AddStringToObject(root, "response_format", "mp3");
+    char *body = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (!body) {
+        return false;
+    }
+
+    s_tts_overflow = false;
+    bool ok = openai_perform(URL, TTS_API_KEY, "application/json", body, strlen(body), 0);
+    if (ok && s_tts_overflow) {
+        ok = false;   /* speech outran playback: captions are safer than broken audio */
+    }
+    free(body);
+    ESP_LOGI(TAG, "TTS %s: %u bytes in %lld ms", ok ? "ok" : "failed", s_tts_bytes_total, (now_us() - t0) / 1000);
+    return ok;
+}
+
+/* One sentence, spoken while the chat stream is still writing the next one.
+ * Appends to the turn's MP3 buffer without resetting it (sentences share it). */
+static bool tts_fetch_sentence(const char *text, size_t len)
+{
+    char say[1024];
+    size_t j = 0;
+    for (size_t i = 0; i < len && j + 2 < sizeof(say); i++) {
+        char c = text[i];
+        if (c == '*' || c == '#' || c == '`' || c == '_' || c == '\r') {
+            continue;
+        }
+        say[j++] = c;
+    }
+    say[j] = '\0';
+    bool blank = true;
+    for (size_t i = 0; i < j; i++) {
+        if (say[i] != ' ' && say[i] != '\n' && say[i] != '\r' && say[i] != '\t') {
+            blank = false;
+            break;
+        }
+    }
+    if (blank) {
+        return true;
+    }
+    cJSON *root = cJSON_CreateObject();
+    if (!root) {
+        return false;
+    }
+    cJSON_AddStringToObject(root, "model", tts_model_for(say));
+    cJSON_AddStringToObject(root, "input", say);
+    if (TTS_VOICE[0]) {
+        cJSON_AddStringToObject(root, "voice", TTS_VOICE);
+    }
+    cJSON_AddStringToObject(root, "response_format", "mp3");
+    char *body = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (!body) {
+        return false;
+    }
+    s_tts_first = true;
+    s_tts_skip = 0;
+    bool ok = http_post(&s_tts_cli, (void *)1, TTS_URL, TTS_API_KEY, "application/json", body, strlen(body));
+    free(body);
+    return ok;
+}
+
+/* ---- Brain: bring your own brain (any OpenAI-compatible endpoint) ---- */
+
+#define BRAIN_HIST_MSGS 8             /* user/assistant entries kept in RAM */
+#define BRAIN_HIST_LEN 512
+#define BRAIN_BOUNDARY "esp32thinks7d3a"
+
+static esp_err_t brain_http_event(esp_http_client_event_t *evt)
+{
+    if (evt->event_id == HTTP_EVENT_ON_DATA && s_http_sink &&
+        s_http_sink_len < BRAIN_SINK_BYTES - 1) {
+        size_t room = BRAIN_SINK_BYTES - 1 - s_http_sink_len;
+        size_t n = evt->data_len < room ? evt->data_len : room;
+        memcpy(s_http_sink + s_http_sink_len, evt->data, n);
+        s_http_sink_len += n;
+    }
+    return ESP_OK;
+}
+
+/* One HTTPS POST; the response accumulates in s_http_sink. */
+/* (brain HTTP now goes through openai_perform() above.) */
+
+/* Speech-to-text: multipart-uploads the staged WAV, returns the transcript. */
+/* Trim leading/trailing near-silence from a 16-bit mono WAV in place. The
+ * upload dominates the STT round trip and a PTT note is mostly air at the
+ * edges; keeping 200ms of padding preserves natural speech onsets. */
+static size_t wav_trim_silence(uint8_t *wav, size_t len)
+{
+    const size_t HDR = 44;
+    if (len <= HDR + 2 * 800) {   /* under ~50ms of audio */
+        return len;
+    }
+    int16_t *smp = (int16_t *)(wav + HDR);
+    size_t n = (len - HDR) / 2;
+    const int FLOOR_AMP = 80;   /* mic noise floor measured ~-55 dBFS */
+    const size_t PAD = 3200;    /* 200ms at 16 kHz */
+    size_t a = 0, b = n;
+    while (a < n && smp[a] < FLOOR_AMP && smp[a] > -FLOOR_AMP) {
+        a++;
+    }
+    while (b > a && smp[b - 1] < FLOOR_AMP && smp[b - 1] > -FLOOR_AMP) {
+        b--;
+    }
+    if (b <= a) {   /* all silence: keep the first 200ms so the server still answers */
+        a = 0;
+        b = n < 2 * PAD ? n : 2 * PAD;
+    } else {
+        a = a > PAD ? a - PAD : 0;
+        b = b + PAD < n ? b + PAD : n;
+    }
+    if (a == 0 && b == n) {
+        return len;
+    }
+    memmove(wav + HDR, wav + HDR + 2 * a, 2 * (b - a));
+    return HDR + 2 * (b - a);
+}
+
+static bool brain_stt(const uint8_t *wav, size_t len, char *out, size_t outlen)
+{
+    char head[640];
+    snprintf(head, sizeof(head),
+             "--" BRAIN_BOUNDARY "\r\n"
+             "Content-Disposition: form-data; name=\"model\"\r\n\r\n" BRAIN_STT_MODEL "\r\n"
+             "--" BRAIN_BOUNDARY "\r\n"
+             "Content-Disposition: form-data; name=\"language\"\r\n\r\n" BRAIN_STT_LANG "\r\n"
+             "--" BRAIN_BOUNDARY "\r\n"
+             "Content-Disposition: form-data; name=\"prompt\"\r\n\r\n" BRAIN_STT_PROMPT "\r\n"
+             "--" BRAIN_BOUNDARY "\r\n"
+             "Content-Disposition: form-data; name=\"file\"; filename=\"note.wav\"\r\n"
+             "Content-Type: audio/wav\r\n\r\n");
+    static const char tail[] = "\r\n--" BRAIN_BOUNDARY "--\r\n";
+    size_t hlen = strlen(head), tlen = strlen(tail);
+    len = wav_trim_silence((uint8_t *)wav, len);
+    memcpy(s_brain_post, head, hlen);
+    memcpy(s_brain_post + hlen, wav, len);
+    memcpy(s_brain_post + hlen + len, tail, tlen);
+    /* A reused keep-alive socket the server just closed yields a 0-byte 200;
+     * retry once right away instead of punting to the slow note path. */
+    bool got = false;
+    for (int attempt = 0; attempt < 2 && !got; attempt++) {
+        if (!openai_perform(BRAIN_STT_URL, BRAIN_CHAT_KEY, "multipart/form-data; boundary=" BRAIN_BOUNDARY,
+                        reinterpret_cast<const char *>(s_brain_post), hlen + len + tlen, 1)) {
+            ESP_LOGE(TAG, "STT http failed (attempt %d)", attempt);
+            continue;
+        }
+        ESP_LOGI(TAG, "STT resp %u bytes: %.200s", (unsigned)s_http_sink_len,
+                 s_http_sink ? (const char *)s_http_sink : "(null)");
+        got = s_http_sink_len > 0;
+    }
+    if (!got) {
+        return false;
+    }
+    cJSON *root = cJSON_Parse(s_http_sink);
+    if (!root) {
+        return false;
+    }
+    const char *text = cJSON_GetStringValue(cJSON_GetObjectItem(root, "text"));
+    bool ok = text && text[0];
+    if (ok) {
+        strlcpy(out, text, outlen);
+    }
+    cJSON_Delete(root);
+    return ok;
+}
