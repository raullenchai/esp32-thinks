+/* ---- TTS: speaks gadget replies via OpenAI ---- */
+
+static void tts_data(const uint8_t *data, size_t len);
+
+extern const uint8_t openai_root_ca_pem_start[] asm("_binary_openai_root_ca_pem_start");
+extern const uint8_t openai_root_ca_pem_end[] asm("_binary_openai_root_ca_pem_end");
+
+static esp_err_t tts_http_event(esp_http_client_event_t *evt)
+{
+    if (evt->event_id == HTTP_EVENT_ON_DATA && evt->client &&
+        esp_http_client_get_status_code(evt->client) == 200) {
+        tts_data((const uint8_t *)evt->data, evt->data_len);
+    }
+    return ESP_OK;
+}
+
+/* Streams one message MP3 from OpenAI into tts_data(); true on success. */
+static bool tts_fetch_openai(const char *text)
+{
+    static const char *URL = "https://api.openai.com/v1/audio/speech";
+
+    cJSON *root = cJSON_CreateObject();
+    if (!root) {
+        return false;
+    }
+    cJSON_AddStringToObject(root, "model", TTS_MODEL);
+    cJSON_AddStringToObject(root, "input", text);
+    cJSON_AddStringToObject(root, "voice", TTS_VOICE);
+    cJSON_AddStringToObject(root, "response_format", "mp3");
+    char *body = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (!body) {
+        return false;
+    }
+
+    esp_http_client_config_t cfg = {};
+    cfg.url = URL;
+    cfg.method = HTTP_METHOD_POST;
+    cfg.cert_pem = (const char *)openai_root_ca_pem_start;
+    cfg.timeout_ms = 15000;
+    cfg.event_handler = tts_http_event;
+    esp_http_client_handle_t cli = esp_http_client_init(&cfg);
+    if (!cli) {
+        free(body);
+        return false;
+    }
+    esp_http_client_set_header(cli, "Authorization", "Bearer " TTS_API_KEY);
+    esp_http_client_set_header(cli, "Content-Type", "application/json");
+    esp_http_client_set_post_field(cli, body, strlen(body));
+
+    bool ok = esp_http_client_perform(cli) == ESP_OK &&
+              esp_http_client_get_status_code(cli) == 200;
+    esp_http_client_cleanup(cli);
+    free(body);
+    ESP_LOGI(TAG, "TTS %s: %u audio bytes buffered", ok ? "ok" : "failed", (unsigned)s_turn.mp3_len);
+    return ok;
+}
